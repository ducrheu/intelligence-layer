{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/intelligence/artifact.schema.json",
  "title": "Intelligence Artifact",
  "type": "object",
  "required": ["id", "kind", "scope", "status", "version", "title", "content", "created_by", "created_at", "updated_at", "source", "provenance", "verified", "applies_to", "compatibility", "tests", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["knowledge", "experience", "skill", "source"]},
    "scope": {"enum": ["shared", "project", "domain"]},
    "status": {"enum": ["candidate", "experimental", "validated", "approved", "stale", "deprecated", "archived"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "verified": {"type": "boolean"},
    "verified_by": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "compatibility": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "review_interval_days": {"type": ["integer", "null"], "minimum": 1},
    "tests": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
