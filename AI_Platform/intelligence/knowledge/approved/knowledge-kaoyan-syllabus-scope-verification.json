{
  "id": "knowledge-kaoyan-syllabus-scope-verification",
  "kind": "knowledge",
  "scope": "domain",
  "status": "approved",
  "version": "1.0.0",
  "title": "\u5377\u9762\u8303\u56f4\u53ea\u6709\u8003\u7eb2\u539f\u6587\u7b97\u6570\uff1a\u8de8\u6765\u6e90\u8f6c\u8ff0\u4e00\u5f8b\u6309\u5f85\u6838\u5b9e\u5904\u7406",
  "content": "## \u9002\u7528\u573a\u666f\n\u4efb\u4f55\u300c\u67d0\u79d1\u8003\u4e0d\u8003\u67d0\u4e2a\u77e5\u8bc6\u70b9\u300d\u7684\u5224\u65ad\uff0c\u5c24\u5176\u662f\u4ece peer agent\u3001\u673a\u6784\u7f51\u7ad9\u3001\u7ecf\u9a8c\u5e16\u8f6c\u8ff0\u6765\u7684\u7ed3\u8bba\u3002\n\n## \u7ed3\u8bba\uff08\u53ef\u6267\u884c\uff09\n1. \u53ea\u6709\u8003\u7eb2\u539f\u6587\uff08\u300c\u8003\u8bd5\u5185\u5bb9 / \u8003\u8bd5\u8981\u6c42\u300d\u4e24\u8282\uff09\u7b97\u6570\u3002\u5176\u4ed6\u6765\u6e90\u7684\u8bf4\u6cd5\u4e00\u5f8b\u6807\u300c\u5f85\u6838\u5b9e\u300d\uff0c\u4e0d\u5199\u8fdb\u8ba1\u5212\u3002\n2. \u9010\u6761\u6838\u5230\u539f\u53e5\uff0c\u518d\u51b3\u5b9a\u8fd9\u6761\u5b66\u4e60\u7ebf\u5f52\u54ea\u4e00\u7c7b\uff08\u65b0\u6218\u7ebf / \u53ef\u8026\u5408 / \u4e0d\u5fc5\u5f00\uff09\u3002\n3. \u672c\u673a\u5b9e\u6d4b\u6848\u4f8b\uff1apeer agent \u65ad\u8a00\u67d0\u7edf\u8003\u79d1\u76ee\u4e0d\u8003\u62c9\u683c\u6717\u65e5\u4e58\u6570\u6cd5\u3001\u4e8c\u6b21\u578b\u3001\u77e9\u9635\u6c42\u9006\uff0c\u636e\u6b64\u5f97\u51fa\u300c\u8fd9\u95e8\u8bfe\u4e0e\u4e3b\u7ebf\u51e0\u4e4e\u6ca1\u6709\u5171\u7528\u5de5\u5177\uff0c\u522b\u5f53\u7ec3\u4e60\u573a\u300d\uff1b\u6838\u8003\u7eb2\u539f\u6587\u540e\u4e09\u9879\u5168\u5728\u8be5\u79d1\u76ee\u91cc\uff0c\u7ed3\u8bba\u7ffb\u6210\u300c\u8fd9\u95e8\u8bfe\u5c31\u662f\u8be5\u79d1\u5de5\u5177\u7684\u5e94\u7528\u9898\u6f14\u7ec3\u573a\u300d\u2014\u2014\u4ece\u300c\u65b0\u6218\u7ebf\u300d\u53d8\u6210\u300c\u53ef\u8026\u5408\u300d\u3002\u5dee\u7684\u5c31\u662f\u6838\u5b9e\u8fd9\u4e00\u6b65\u3002\n4. \u66f4\u6b63\u540e\u56de\u6295\u7ed9\u5f15\u7528\u8fc7\u65e7\u7ed3\u8bba\u7684 peer\uff0c\u4e0d\u8981\u53ea\u5728\u672c\u5730\u6539\u3002\n\n## \u8fb9\u754c\uff08\u54ea\u4e9b\u6ca1\u9a8c\u8bc1\uff09\n\u6848\u4f8b\u57fa\u4e8e 2026 \u7248\u67d0\u6821 085411 \u8003\u7eb2\uff1b2027 \u62db\u751f\u76ee\u5f55\u53d1\u5e03\u540e\u987b\u91cd\u6838\u3002\u5176\u4ed6\u9662\u6821/\u79d1\u76ee\u672a\u9010\u6761\u6838\u5bf9\u3002\n\n## \u4e0d\u9002\u7528\n\u624b\u4e0a\u5df2\u6709\u5bf9\u5e94\u5e74\u4efd\u7684\u8003\u7eb2\u539f\u6587\u3001\u4e14\u7248\u672c\u786e\u8ba4\u65f6\u2014\u2014\u76f4\u63a5\u5f15\u7528\u5373\u53ef\uff0c\u4e0d\u5fc5\u518d\u8d70\u4e00\u904d\u6838\u5b9e\u6d41\u7a0b\u3002",
